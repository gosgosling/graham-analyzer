.env
# e-disclosure Playwright cookies (may contain session secrets)
tools/edisclosure-scraper/.edisclosure_storage_state.json

# Отчёты покрытия — вход для scripts/code_quality.py, в гит не нужны
.coverage
coverage.json
htmlcov/

# Байткод скриптов в корне (scripts/) — появляется при прогоне метрик
__pycache__/

# Логи прогонов скрапера — в репозитории лежало 2.2 МБ таких файлов
*.log
