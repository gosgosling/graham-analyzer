.env
.env.bak.*
# Боевые настройки сервера — пароли базы, почты, токены
.env.prod
deploy/.env*
!deploy/env.prod.example
# e-disclosure Playwright cookies (may contain session secrets)
# Сессия e-disclosure (куки) и её резервные копии — секрет
tools/edisclosure-scraper/.edisclosure_storage_state.json*

# Отчёты покрытия — вход для scripts/code_quality.py, в гит не нужны
.coverage
coverage.json
htmlcov/

# Байткод скриптов в корне (scripts/) — появляется при прогоне метрик
__pycache__/

# Логи прогонов скрапера — в репозитории лежало 2.2 МБ таких файлов
*.log

# Локальные копии логотипов компаний (чужие товарные знаки — не в гит)
/data/

# Данные аккаунтов из бэкапов (email, хэши паролей, сессии) — только локально
backups/private/

# Документация, планы, гайды и материалы к конференции — только локально,
# в публичный репозиторий не попадают (из истории убраны clean_history.sh).
/docs/
/plans/
/ROADMAP GA.md
/conference-2026/
/.claude/
/.cursor/rules/
