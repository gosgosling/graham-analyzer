# Application
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database (пока не используется, но подготовим)
POSTGRES_USER=graham_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=graham_analyzer
DATABASE_URL=postgresql://graham_user:12345678@localhost:5432/graham_analyzer
# Лог каждого SQL-запроса — только для отладки, на демо не включать
SQL_ECHO=false

# Redis (пока не используется)
REDIS_URL=redis://localhost:6379/0

# Tinkoff Invest API
# Получите токен в личном кабинете Тинькофф Инвестиций: https://www.tinkoff.ru/invest/
TINKOFF_TOKEN=your_token_here

# Дополнительные корневые сертификаты — склеиваются с certifi. Нужны, если
# сервер отдаёт цепочку от УЦ, которого нет в стандартном хранилище: так
# работает T-Invest (корень «Russian Trusted Root CA» Минцифры).
# Путь относительный считается от backend/. См. backend/certs/README.md
EXTRA_CA_CERTS=certs/russian_trusted_ca.pem
# ── Доступ и аккаунты (docs/SECURITY.md) ──
# На сервере: DEBUG=false, COOKIE_SECURE=true, адреса — https://адрес-сайта
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Почта (Яндекс): логин и отправитель — один адрес, пароль — пароль приложения.
# Пусто — письма пишутся в журнал сервера. Проверка: python -m scripts.check_mail адрес
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
