# SITE_ADDRESS — домен сайта (graham.example.ru): Caddy сам получит и
# продлит сертификат Let's Encrypt. Можно несколько через запятую:
# «graham.example.ru, www.graham.example.ru» — сертификат будет на оба.
# Для проверки на своей машине — «:80», тогда сайт работает по http без
# сертификата.
{$SITE_ADDRESS} {
	# www.домен → домен: у сайта один адрес, иначе куки входа живут на двух
	# адресах по отдельности и вход «теряется» при переходе между ними.
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	encode zstd gzip

	# API: путь /api срезается, бэкенд видит свои обычные адреса.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Исходные PDF отчётов — на скачивание, рядом с числами, которые из них
	# взяты (backend/app/services/reports/report_files.py). Манифест наружу
	# не отдаётся: в нём локальные пути архива.
	handle_path /files/reports/* {
		respond /manifest.json 404
		root * /reports
		header Cache-Control "public, max-age=86400"
		header X-Robots-Tag "noindex"
		file_server
	}

	handle {
		root * /srv
		# Сборка с хэшами в именах — кэшировать надолго; index.html — никогда:
		# в нём ссылки на свежую сборку.
		@hashed path /static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Файлы сборки (static, иконки, robots.txt) — как есть.
		@asset {
			file
			not path /
		}
		handle @asset {
			file_server
		}
		# Адреса приложения (/company/171, /screen, /sitemap.xml) — бэкенду:
		# он берёт index.html этой же сборки и дописывает под адрес заголовок,
		# описание, превью ссылки и текст с цифрами для тех, кто не выполняет
		# скрипт (поисковики, Telegram). См. backend/app/routers/pages_router.py.
		handle {
			rewrite * /_page{path}
			reverse_proxy backend:8000
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Журнал запросов — в файл на диске сервера (../logs/caddy), а не только в
	# вывод контейнера: тот пропадает при пересборке, и по нему не посчитать
	# посещаемость. Отчёт по журналу — deploy/traffic-report.sh.
	# Новый файл раз в сутки, файлы старше 30 дней удаляются: столько журналы
	# хранятся по политике конфиденциальности. Cookie и Authorization Caddy в
	# журнал не пишет (log_credentials выключен по умолчанию).
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_interval 24h
			roll_keep_for 720h
			roll_keep 60
		}
		format json
	}
}

# Внутренний адрес сборки: отсюда бэкенд берёт index.html (WEB_INDEX_URL).
# Порт наружу не открыт — только во внутренней сети compose.
http://:8080 {
	root * /srv
	file_server
}
