# Боевые настройки. Скопировать в deploy/.env.prod и заполнить.
# Файл .env.prod в git не попадает.

# ── Адрес ──
# Домен сайта: Caddy получит для него сертификат. Для проверки на своей
# машине — «:80» и ALLOWED_ORIGINS/PUBLIC_SITE_URL=http://localhost:8080.
SITE_ADDRESS=graham.example.ru
ALLOWED_ORIGINS=https://graham.example.ru
PUBLIC_SITE_URL=https://graham.example.ru
COOKIE_SECURE=true

# ── Приложение ──
DEBUG=false
# Длинная случайная строка: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SQL_ECHO=false

# ── База ──
POSTGRES_USER=graham
# Длинный случайный пароль: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=graham_analyzer

# ── Аккаунты ──
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ── Почта (Яндекс 360, пароль приложения) ──
# Пусто — письма не уходят, ссылка пишется в журнал (регистрацию тогда
# лучше не открывать).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ── Цены ──
# Токен T-Invest только на чтение. Пусто — текущая цена не обновляется,
# остаётся ежедневная история Мосбиржи.
TINKOFF_TOKEN=
EXTRA_CA_CERTS=certs/russian_trusted_ca.pem

# Разбор PDF на сервере не идёт: LLM-ключи здесь не нужны.
